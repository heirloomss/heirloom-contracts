# Heirloom Contracts — environment configuration
# Copy to .env and fill in the values for your deployment.

# Stellar network to target: testnet | mainnet
NETWORK=testnet

# Soroban RPC endpoint for the chosen network
RPC_URL=https://soroban-testnet.stellar.org

# Deployed Legacy contract id (filled in after `scripts/deploy.sh`)
CONTRACT_ID=
